{
  "name": "clausewatch",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "size": "node scripts/bundle-size.mjs",
    "smoke": "node scripts/smoke.mjs",
    "mutation": "node scripts/mutate.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:rules": "node scripts/check-sites.mjs && go -C tools/rulecheck vet ./... && go -C tools/rulecheck test ./... && go -C tools/rulecheck run . ../../rules && go -C tools/rulecheck run . ../../rules/es && go -C tools/rulecheck run . ../../rules/fr",
    "leak-guard": "node scripts/leak-guard.mjs --self-test && node scripts/leak-guard.mjs",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "playwright": "1.65.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438",
    "re2js": "2.9.1",
    "tinyld": "1.3.4",
    "tldts": "7.4.19"
  }
}
