{
  "version": 1,
  "flags": "i",
  "minQuoteWords": 8,
  "categories": [
    "data_sale",
    "auto_renewal",
    "arbitration"
  ],
  "rules": [
    {
      "id": "es-data-sale",
      "category": "data_sale",
      "all": [
        "(vendemos|podemos vender) (sus |tus )?datos personales"
      ],
      "none": [
        "\\b(no|nunca|jam[aá]s)\\s+(les\\s+|le\\s+)?(vendemos|venderemos|podemos\\s+vender)\\b"
      ]
    },
    {
      "id": "es-renewal",
      "category": "auto_renewal",
      "all": [
        "(suscripci[oó]n|plan)",
        "(renueva|renovar[aá]).{0,100}autom[aá]ticamente"
      ],
      "none": [
        "\\b(no|nunca|jam[aá]s)\\s+(se\\s+|la\\s+|lo\\s+)?(renueva|renovar)"
      ]
    },
    {
      "id": "es-arbitration",
      "category": "arbitration",
      "all": [
        "(disputas|controversias).{0,100}(arbitraje vinculante|arbitraje obligatorio)"
      ],
      "none": [
        "\\b(no|nunca)\\s+(se\\s+)?(requieren?|exigen?|est[aá]n\\s+sujetas?|estar[aá]n\\s+sujetas?|ser[aá]n\\s+sometidas?|someter[aá]n|resolver[aá]n)\\s+(a\\s+|mediante\\s+|por\\s+)?(un\\s+)?arbitraje\\s+(vinculante|obligatorio)"
      ]
    }
  ]
}
