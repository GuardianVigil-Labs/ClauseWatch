{
  "version": 1,
  "flags": "i",
  "minQuoteWords": 8,
  "categories": [
    "data_sale",
    "auto_renewal",
    "arbitration"
  ],
  "rules": [
    {
      "id": "fr-data-sale",
      "category": "data_sale",
      "all": [
        "nous (pouvons vendre|vendons) vos donn[eé]es personnelles"
      ],
      "none": [
        "\\bnous\\s+ne\\s+(les\\s+)?(vendons|vendrons|pouvons)\\b"
      ]
    },
    {
      "id": "fr-renewal",
      "category": "auto_renewal",
      "all": [
        "(abonnement|forfait)",
        "(renouvel[eé]|renouvellera).{0,100}automatiquement"
      ],
      "none": [
        "\\bne\\s+(sera|seront|se|le|la)\\s+(pas|jamais|plus)\\s+renouvel|\\bne\\s+(se\\s+)?renouvel\\w*\\s+(pas|jamais|plus)\\b|\\bn['’](est|sera)\\s+(pas|jamais|plus)\\s+renouvel"
      ]
    },
    {
      "id": "fr-arbitration",
      "category": "arbitration",
      "all": [
        "(litiges|diff[eé]rends).{0,100}(arbitrage obligatoire|arbitrage contraignant)"
      ],
      "none": [
        "\\bne\\s+(n[eé]cessitent|n[eé]cessite|seront|sont|sera|est)\\s+(pas|jamais|plus)\\b[^.,;]{0,30}\\barbitrage"
      ]
    }
  ]
}
